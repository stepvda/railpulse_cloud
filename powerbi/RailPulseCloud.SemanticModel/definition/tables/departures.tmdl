		sourceColumn: delay_first_seen_s
		lineageTag: 244fc91e-8b53-5853-982b-4a4ae71fedc5

	column delay_growth_s
		dataType: int64
		sourceColumn: delay_growth_s
		lineageTag: 25dbab53-9276-542c-acd1-c1fc5a161e07

	measure Departures = COUNTROWS('departures')
		lineageTag: 1ba3c686-7de5-5f3f-af7b-5bcbb41e388d

	measure Cancellations = CALCULATE(COUNTROWS('departures'), 'departures'[is_canceled] = TRUE())
		lineageTag: b8508358-a447-589b-9bf3-34bd5b8c1b05

	measure 'Trains measured' = COUNTA('departures'[is_on_time_6min])
		lineageTag: 3ccd689f-cae8-5e4b-99d5-4c48d26cd634

	measure 'On time 6min %' = DIVIDE(CALCULATE(COUNTA('departures'[is_on_time_6min]), 'departures'[is_on_time_6min] = TRUE()), COUNTA('departures'[is_on_time_6min]))
		formatString: 0.0%
		lineageTag: 4559dda0-33db-534e-8f36-fc24a8ff27b4

	measure 'On-Time Rate %' = DIVIDE(CALCULATE(COUNTA('departures'[is_on_time_2min]), 'departures'[is_on_time_2min] = TRUE()), COUNTA('departures'[is_on_time_2min]))
		formatString: 0.0%
		lineageTag: 8cf51f22-bdab-5803-8269-358bcf204162

	measure 'Mean delay s' = CALCULATE(AVERAGE('departures'[delay_seconds]), 'departures'[is_canceled] = FALSE())
		formatString: 0.0
		lineageTag: 79217a1d-064a-5ffd-831f-188dce61cc5a

	measure 'Mean delay min' = DIVIDE(CALCULATE(AVERAGE('departures'[delay_seconds]), 'departures'[is_canceled] = FALSE()), 60)
		formatString: 0.0
		lineageTag: 976606ad-0c7d-5ccf-b62c-8a719bae7b69

	measure 'Delay minutes' = DIVIDE(CALCULATE(SUM('departures'[delay_seconds]), 'departures'[is_canceled] = FALSE()), 60)
		formatString: #,0
		lineageTag: 88d8ddb5-515d-5008-9c34-27f2d34c1947

	measure 'Share of delay %' = DIVIDE([Delay minutes], CALCULATE([Delay minutes], ALL('departures')))
		formatString: 0.0%
		lineageTag: 1b6cb6dc-8513-5d79-8c25-e0cf90ae3338

	measure 'Cancelled %' = DIVIDE([Cancellations], [Departures])
		formatString: 0.0%
		lineageTag: a96564e0-64d5-514c-b663-59e82b327dcf

	measure 'Platform changes' = CALCULATE(COUNTROWS('departures'), 'departures'[platform_is_normal] = FALSE())
		lineageTag: 8180c53d-f85d-53c5-bca8-d7c4e6b35767

	measure 'Reliability score' = DIVIDE(CALCULATE(COUNTA('departures'[is_on_time_6min]), 'departures'[is_on_time_6min] = TRUE()) - [Cancellations], COUNTA('departures'[is_on_time_6min]))
		formatString: 0.0%
		lineageTag: 625cdd8e-6210-54f4-9626-ee2655f50a93

	measure 'Days observed' = DISTINCTCOUNT('departures'[date_key])
		lineageTag: 325e50c4-6c3c-5337-9d5b-683bbd027ce1

	measure 'Departures per day' = DIVIDE([Departures], [Days observed])
		formatString: 0.0
		lineageTag: 2ddcf077-a988-5d8a-a692-b946ed893d8e

	measure 'Delay growth s' = AVERAGE('departures'[delay_growth_s])
		formatString: 0.0
		lineageTag: 2988b82b-ed97-5f41-a9a1-b79c1700a7e1

	measure 'Deteriorated 5min+' = CALCULATE(COUNTROWS('departures'), 'departures'[delay_growth_s] > 300)
		lineageTag: 93939478-59f0-5332-b77e-a581b019c107

	partition departures = m
		mode: import
		source =
				let
				    Source = Sql.Database(ServerName, DatabaseName),
				    Data = Source{[Schema="dbo",Item="v_bi_departures"]}[Data]
				in
				    Data

	annotation PBI_ResultType = Table
